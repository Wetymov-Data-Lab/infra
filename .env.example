# ========================================================
# Runtime
# ========================================================
# Local development defaults. Replace all credentials outside local environments.
VENDOR_NETWORK_NAME=vendor-network
RESTART_POLICY=unless-stopped
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# ========================================================
# PostgreSQL
# ========================================================
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_CONTAINER_NAME=wdl-postgres
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres
POSTGRES_VOLUME_NAME=wdl-postgres17-data
POSTGRES_MAX_REPLICATION_SLOTS=10
POSTGRES_MAX_WAL_SENDERS=10

# ========================================================
# Application databases
# ========================================================
CORE_POSTGRES_DB=wdl
IDENTITY_POSTGRES_DB=wdl_identity

# ========================================================
# Redis
# ========================================================
REDIS_IMAGE=redis:7.2-alpine
REDIS_CONTAINER_NAME=wdl-redis
REDIS_BIND_HOST=127.0.0.1
REDIS_PUBLISHED_PORT=6379
REDIS_VOLUME_NAME=wdl-redis-data

# ========================================================
# MinIO
# ========================================================
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CONTAINER_NAME=wdl-minio
MINIO_INIT_CONTAINER_NAME=wdl-minio-init
MINIO_BIND_HOST=127.0.0.1
MINIO_API_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_VOLUME_NAME=wdl-minio-data
MINIO_AUDIT_BUCKET=audit-log

# ========================================================
# Kafka
# ========================================================
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_CONTAINER_NAME=wdl-kafka
KAFKA_INIT_CONTAINER_NAME=wdl-kafka-init
KAFKA_BIND_HOST=127.0.0.1
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PUBLISHED_PORT=9094
KAFKA_VOLUME_NAME=wdl-kafka-data
KAFKA_NUM_PARTITIONS=1
KAFKA_AUDIT_TOPICS=wdl-core.public.audit_log,wdl-identity.public.audit_log

# ========================================================
# Debezium
# ========================================================
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.6.2.Final
DEBEZIUM_CONTAINER_NAME=wdl-debezium
DEBEZIUM_INIT_CONTAINER_NAME=wdl-debezium-init
DEBEZIUM_BIND_HOST=127.0.0.1
DEBEZIUM_PUBLISHED_PORT=8083
DEBEZIUM_HEARTBEAT_INTERVAL_MS=10000

# ========================================================
# ClickHouse
# ========================================================
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8-alpine
CLICKHOUSE_CONTAINER_NAME=wdl-clickhouse
CLICKHOUSE_INIT_CONTAINER_NAME=wdl-clickhouse-init
CLICKHOUSE_BIND_HOST=127.0.0.1
CLICKHOUSE_HTTP_PUBLISHED_PORT=8123
CLICKHOUSE_NATIVE_PUBLISHED_PORT=9002
CLICKHOUSE_DB=auditlog
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_VOLUME_NAME=wdl-clickhouse-data

# ========================================================
# Audit retention
# ========================================================
AUDIT_HOT_RETENTION_DAYS=30
AUDIT_TOTAL_RETENTION_DAYS=365
AUDIT_ERROR_RETENTION_DAYS=30
