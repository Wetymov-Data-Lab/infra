<clickhouse>
    <storage_configuration>
        <disks>
            <audit_cold>
                <type>s3</type>
                <endpoint from_env="CLICKHOUSE_COLD_STORAGE_ENDPOINT" />
                <access_key_id from_env="MINIO_ROOT_USER" />
                <secret_access_key from_env="MINIO_ROOT_PASSWORD" />
            </audit_cold>
        </disks>
        <policies>
            <audit_hot_cold>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>audit_cold</disk>
                    </cold>
                </volumes>
            </audit_hot_cold>
        </policies>
    </storage_configuration>
</clickhouse>
